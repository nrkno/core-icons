{
  "name": "@nrk/core-icons",
  "version": "19.2.1",
  "description": "The official icons for NRK.",
  "homepage": "https://static.nrk.no/core-icons/latest/",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "NRK <opensource@nrk.no> (https://www.nrk.no/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrkno/core-icons.git"
  },
  "bin": {
    "core-icons-codemod": "bin/codemod.js"
  },
  "files": [
    "dist",
    "bin/codemod.js",
    "bin/codemod-map.json"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json",
    "#lib/*": "./lib/*",
    "#cli/*": "./src/cli/*",
    "#utils/*": "./src/utils/*",
    "#src/*": "./src/*",
    "#figma/*": "./src/figma/*"
  },
  "exports": {
    ".": {
      "types": "./dist/effective.d.ts",
      "require": "./dist/effective.cjs",
      "import": "./dist/effective.js"
    },
    "./expressive": {
      "types": "./dist/expressive.d.ts",
      "require": "./dist/expressive.cjs",
      "import": "./dist/expressive.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "require": "./dist/logo.cjs",
      "import": "./dist/logo.js"
    },
    "./logo/large": {
      "types": "./dist/compat-logo-large.d.ts",
      "require": "./dist/compat-logo-large.cjs",
      "import": "./dist/compat-logo-large.js"
    },
    "./jsx": {
      "types": "./dist/compat-jsx-effective.d.ts",
      "require": "./dist/compat-jsx-effective.cjs",
      "import": "./dist/compat-jsx-effective.js"
    },
    "./jsx/expressive": {
      "types": "./dist/compat-jsx-expressive.d.ts",
      "require": "./dist/compat-jsx-expressive.cjs",
      "import": "./dist/compat-jsx-expressive.js"
    },
    "./jsx/logo": {
      "types": "./dist/compat-jsx-logo.d.ts",
      "require": "./dist/compat-jsx-logo.cjs",
      "import": "./dist/compat-jsx-logo.js"
    },
    "./jsx/logo/large": {
      "types": "./dist/compat-jsx-logo-large.d.ts",
      "require": "./dist/compat-jsx-logo-large.cjs",
      "import": "./dist/compat-jsx-logo-large.js"
    }
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:docs",
    "build:lib": "rolldown -c rolldown.config.ts",
    "build:docs": "vite build docs",
    "dev": "vite docs",
    "lint": "oxfmt --check && oxlint",
    "format": "oxfmt --write",
    "test": "vitest run",
    "test:watch": "vitest --ui",
    "release": "npm run build && publint && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@changesets/write": "^0.4.0",
    "@figma/rest-api-spec": "^0.41.0",
    "@types/node": "^24.12.4",
    "@vitest/ui": "^4.1.10",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "rolldown": "^1.2.1",
    "rolldown-plugin-dts": "^0.28.0",
    "svgo": "4.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "24.15.0"
  }
}
